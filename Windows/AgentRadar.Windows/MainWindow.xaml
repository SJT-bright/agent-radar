<Window x:Class="AgentRadar.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务雷达"
        Width="60" Height="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="White"
        AutomationProperties.AutomationId="AgentRadarPanel"
        AutomationProperties.Name="任务雷达">
  <Border x:Name="Shell" CornerRadius="18">
    <Grid>
      <Grid x:Name="ExpandedHost" Width="238" HorizontalAlignment="Right"/>
      <Grid x:Name="CompactHost" Width="60" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"/>
      <Button x:Name="ExpandButton" Width="30" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
              AutomationProperties.AutomationId="panel.expand" Content="›"/>
    </Grid>
  </Border>
</Window>
